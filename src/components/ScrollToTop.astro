---
// Scroll to Top Button Component
---

<button 
  class="scroll-to-top" 
  aria-label="Scroll to top"
  type="button"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 15l-6-6-6 6"/>
  </svg>
</button>

<script>
  const btn = document.querySelector('.scroll-to-top') as HTMLButtonElement;
  
  // Show/hide based on scroll position
  const toggleVisibility = () => {
    if (window.scrollY > 400) {
      btn?.classList.add('visible');
    } else {
      btn?.classList.remove('visible');
    }
  };
  
  window.addEventListener('scroll', toggleVisibility, { passive: true });
  toggleVisibility();
  
  // Scroll to top on click
  btn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
  
  // Re-attach after View Transitions
  document.addEventListener('astro:after-swap', () => {
    const newBtn = document.querySelector('.scroll-to-top') as HTMLButtonElement;
    
    window.addEventListener('scroll', toggleVisibility, { passive: true });
    toggleVisibility();
    
    newBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  });
</script>

<style>
  .scroll-to-top {
    position: fixed;
    bottom: var(--space-lg);
    right: var(--space-lg);
    z-index: 999;
    
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.8);
    transition: all 0.3s var(--ease-smooth);
    
    box-shadow: 0 4px 20px oklch(70% 0.15 35 / 0.4);
  }
  
  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  
  .scroll-to-top:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 8px 30px oklch(70% 0.15 35 / 0.5);
  }
  
  .scroll-to-top:active {
    transform: translateY(0) scale(0.95);
  }
  
  .scroll-to-top svg {
    transition: transform 0.2s var(--ease-bounce);
  }
  
  .scroll-to-top:hover svg {
    transform: translateY(-2px);
  }
  
  @media (max-width: 768px) {
    .scroll-to-top {
      bottom: var(--space-md);
      right: var(--space-md);
      width: 44px;
      height: 44px;
    }
  }
</style>
